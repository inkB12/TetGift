{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "YOUR_DB_CONNECTION_STRING"
  },
  "Otp": {
    "Secret": "YOUR_OTP_SECRET",
    "ExpireMinutes": 5,
    "DeletePendingAfterMinutes": 30
  },
  "Jwt": {
    "Key": "YOUR_JWT_SECRET_KEY",
    "Issuer": "FitUp",
    "Audience": "FitUpUsers",
    "ExpireMinutes": 60
  },
  "Resend": {
    "ApiKey": "YOUR_RESEND_API_KEY",
    "From": "TetGift <noreply@yourdomain.com>"
  },
  "VnPay": {
    "TmnCode": "YOUR_VNPAY_TMN_CODE",
    "HashSecret": "YOUR_VNPAY_HASH_SECRET",
    "Url": "https://sandbox.vnpayment.vn/paymentv2/vpcpay.html",
    "ReturnUrl": "YOUR_RETURN_URL",
    "IpnUrl": "YOUR_IPN_URL"
  },
  "Gemini": {
    "ApiKey": "YOUR_GEMINI_API_KEY",
    "Model": "gemini-2.5-flash"
  },
  "AllowedHosts": "*",
  "RedisOptions": {
    "ConnectionString": "YOUR_REDIS_CONNECTION_STRING",
    "InstanceName": "TetGift_"
  },
  "CloudinarySettings": {
    "CloudName": "YOUR_CLOUDINARY_CLOUD_NAME",
    "ApiKey": "YOUR_CLOUDINARY_API_KEY",
    "ApiSecret": "YOUR_CLOUDINARY_API_SECRET"
  }
}
